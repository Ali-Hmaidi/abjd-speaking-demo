# Copy to .env and fill in.
# Region must be Azure's short code for a region that hosts Speech (e.g. uaenorth,
# eastus, westeurope). israelcentral has no Speech endpoint and will fail to connect.
AZURE_SPEECH_KEY=your-key-here
AZURE_SPEECH_REGION=uaenorth

# Optional — enables the "Ask the AI coach" button on the read-aloud tab.
# Without one of these the phoneme-based coaching still works; only the LLM
# narrative is hidden. The key stays server-side and is never sent to the page.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
